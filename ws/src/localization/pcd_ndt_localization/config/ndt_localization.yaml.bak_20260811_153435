pcd_ndt_localizer:
  ros__parameters:
    map_path: "/home/seeed/ros2/maps/replay/fastlio_map_manual_001_level_groundsafe_20260729.pcd"
    input_cloud_topic: "/cloud_registered_body"
    odom_topic: "/Odometry"
    initialpose_topic: "/initialpose_relay"

    global_frame: "map"
    base_frame: "relocalization_body"
    # The live-cloud calibrated base_link -> Livox pose is
    # xyz=(0.100, -0.110, 0.749) m and
    # RPY=(-45.937, -0.4065, -90.0) deg. The M12 connector (-X) faces
    # vehicle left (+Y). NDT estimates the Livox/Fast-LIO body
    # pose, so these are the exact inverse transform (localization -> base).
    localization_to_base_roll_rad: 0.007094763
    localization_to_base_pitch_rad: -0.801751898
    localization_to_base_yaw_rad: 1.570796327
    localization_to_base_x_m: -0.115311164
    localization_to_base_y_m: 0.468093861
    localization_to_base_z_m: -0.592192935
    visualization_yaw_offset_rad: 0.0
    # Zero means the last localization marker remains visible until replaced.
    marker_lifetime_sec: 0.0

    map_leaf_size: 0.25
    scan_leaf_size: 0.25
    min_scan_points: 80

    ndt_resolution: 0.7
    ndt_step_size: 0.1
    ndt_trans_eps: 0.01
    ndt_max_iterations: 40
    # Full-resolution scan score observed for the leveled map is about
    # 0.20-0.23. Acquisition still requires the stricter coarse-search gate.
    max_fitness_score: 0.25
    # Run a bounded, one-shot coarse search after every RViz /initialpose.
    # The final full-resolution NDT result must still pass max_fitness_score.
    initial_search_enable: true
    initial_search_xy_range_m: 1.0
    initial_search_xy_step_m: 1.0
    initial_search_yaw_range_rad: 0.261799388
    initial_search_yaw_step_rad: 0.130899694
    initial_search_leaf_size: 0.50
    initial_search_max_iterations: 15
    initial_search_max_candidates: 45
    initial_search_max_fitness_score: 0.10
    initial_confirm_frames: 3
    initial_confirm_translation_m: 0.35
    initial_confirm_rotation_rad: 0.174532925
    path_keep_count: 300
    require_initial_pose: true

    publish_tf: true
    publish_map_cloud: true
    publish_aligned_cloud: true
    map_publish_period_sec: 1.0

    publish_occupancy_grid: true
    occupancy_resolution: 0.10
    # The calibrated floor in this levelled map is z=-0.7559 m.  Keep only
    # points 0.12-1.60 m above that floor, so floor noise cannot become a wall
    # while low furniture and building structure remain represented.
    occupancy_min_z: -0.635880326
    occupancy_max_z: 0.844119674
    occupancy_padding_m: 1.0
    occupancy_inflate_cells: 0
    occupancy_min_points_per_cell: 3
    occupancy_min_z_span: 0.10
    occupancy_save_map_files: false
    occupancy_yaml_path: "/home/seeed/ros2/maps/replay/fastlio_map_manual_001_level_groundsafe_20260729_nav.yaml"
    reject_occupied_pose: true
    reject_pose_outside_grid: true
    occupancy_check_radius_cells: 1
    occupancy_reject_min_occupied_cells: 4
