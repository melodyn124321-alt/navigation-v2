bt_navigator:
  ros__parameters:
    use_sim_time: false
    global_frame: map
    robot_base_frame: base_link
    odom_topic: /odom
    bt_loop_duration: 10
    default_server_timeout: 20
    # The activation wrapper verifies the planner/controller actions before
    # activating BT Navigator.  A 20 s internal wait only prolonged a first
    # Fast DDS discovery miss; retry quickly with the same participant.
    wait_for_service_timeout: 6000
    # Recovery may clear costmaps and wait, but never spin or reverse the chassis.
    default_nav_to_pose_bt_xml: /home/seeed/ros2/nav2/navigate_to_pose_no_spin.xml
    default_nav_through_poses_bt_xml: /home/seeed/ros2/nav2/navigate_through_poses_no_spin.xml
